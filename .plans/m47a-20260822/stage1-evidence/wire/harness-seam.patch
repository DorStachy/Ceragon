+// P47 WIRE-LANE TEST SEAM (harness branch p47/wire-lane-harness only; NOT for merge).
+// Redirects ONLY the Codex wire lane forward destination to a loopback listener so
+// the exact bytes this proxy puts on the wire can be captured. Loopback hosts only.
+// No decision, scan, redaction or policy code is touched, and the managed-base
+// classifier (classifyBaseURL) is deliberately left alone.
+func init() {
+	v := strings.TrimSpace(os.Getenv("DEVOID_TEST_OPENAI_UPSTREAM"))
+	if v == "" {
+		return
+	}
+	u, err := url.Parse(v)
+	if err != nil || u == nil {
+		return
+	}
+	hn := strings.ToLower(u.Hostname())
+	if hn != "localhost" && hn != "::1" && !strings.HasPrefix(hn, "127.") {
+		return
+	}
+	chatgptResponsesHTTP = strings.TrimSuffix(v, "/") + responsesPath
+	chatgptResponsesWS = httpsToWSS(chatgptResponsesHTTP)
+	platformResponsesHTTP = strings.TrimSuffix(v, "/") + responsesPath
+	platformResponsesWS = httpsToWSS(platformResponsesHTTP)
+}
