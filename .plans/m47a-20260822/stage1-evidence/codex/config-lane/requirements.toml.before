# >>> devoid codex machine requirements (managed) >>>
# DeVoid-owned obligations only. Foreign administrator keys are preserved verbatim.
allow_managed_hooks_only = true
# <<< devoid codex machine requirements (managed) <<<

[hooks]
windows_managed_dir = "C:/Users/Owner/AppData/Local/Temp/devoid-p47-iso/progdata/OpenAI/Codex/devoid-managed-hooks"

[[hooks.PreToolUse]]
matcher = "*"

[[hooks.PreToolUse.hooks]]
type = "command"
command = "C:/Users/Owner/AppData/Local/Temp/devoid-p47-iso/devoid.exe ai hook --adapter codex --event PRE_TOOL_USE --provenance 5c6fff536f4863cbf9427a5209ab8292"
commandWindows = "C:/Users/Owner/AppData/Local/Temp/devoid-p47-iso/devoid.exe ai hook --adapter codex --event PRE_TOOL_USE --provenance 5c6fff536f4863cbf9427a5209ab8292"
timeout = 60

