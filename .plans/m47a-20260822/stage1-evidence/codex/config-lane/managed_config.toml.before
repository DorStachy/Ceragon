# Devoid-managed enforcement layer for Codex CLI. Regenerated by Devoid.
# HAZARD: all top-level scalar keys precede every [table] header (TOML re-scopes
# a bare key that follows a table header INTO that table, which fail-closes the load).

approval_policy = "never"
sandbox_mode = "workspace-write"
model_provider = "devoid"

[sandbox_workspace_write]
network_access = false

[tools]
web_search = false

[features]
computer_use = false

[model_providers.devoid]
name = "Devoid Gateway"
base_url = "http://127.0.0.1:19390/proxy/openai/v1"
wire_api = "responses"
requires_openai_auth = true
supports_websockets = false

[mcp_servers.devoid]
command = "devoid-mcp"
args = ["--stdio"]

[shell_environment_policy]
inherit = "core"
