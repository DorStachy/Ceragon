  "type": "object",
  "additionalProperties": false,
  "properties": {
    "dlp": {
      "$ref": "defs.schema.json#/definitions/strictDlpSection"
    },
    "promptRisk": {
      "$ref": "defs.schema.json#/definitions/strictPromptRiskSection"
    },
    "providers": {
      "$ref": "defs.schema.json#/definitions/strictProvidersSection"
    },
    "exclusions": {
      "$ref": "defs.schema.json#/definitions/strictExclusionsSection"
    },
    "mcp": {
      "$ref": "defs.schema.json#/definitions/strictMcpSection"
    },
    "uploads": {
      "$ref": "defs.schema.json#/definitions/strictUploadsSection"
    },
    "paths": {
      "$ref": "defs.schema.json#/definitions/strictPathsSection"
    },
    "agents": {
      "$ref": "defs.schema.json#/definitions/strictAgentsSection"
    },
    "egress": {
      "$ref": "defs.schema.json#/definitions/strictEgressSection"
    },
    "proxy": {
      "$ref": "defs.schema.json#/definitions/strictProxySection"
    },
    "ingress": {
      "$ref": "defs.schema.json#/definitions/strictIngressSection"
    }
  }
}
