{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.ceragon.ai/ai-security-policy/v1/strict-write.schema.json",
  "title": "Ceragon AI Security Policy V1 strict section-level PUT",
  "description": "Strict syntax contract for PUT /api/v1/ai/security-policy. Omitted top-level sections retain the base policy; supplied sections are internally complete except documented default-on fields and partial action maps.",
