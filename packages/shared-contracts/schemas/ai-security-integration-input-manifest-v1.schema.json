{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.ceragon.ai/ai-security/integration-input-manifest-v1.schema.json",
  "title": "Ceragon AI security P0-C07 integration input manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "packetId", "acceptance", "authority", "canonical", "consumers", "rollback", "databaseMigrationIds", "unsupportedSurfaces", "activeWaivers"],
  "properties": {
    "format": { "const": "ceragon.ai-security.integration-input" },
    "formatVersion": { "const": 1 },
    "packetId": { "const": "P0-C07" },
    "acceptance": { "const": "ACCEPTED" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionId", "decisionSha256", "approvalEventSha256", "selection", "representedAuthorities", "approvalRecordedAt", "conditions", "amendments"],
      "properties": {
        "decisionId": { "const": "G-CONTRACT-AUTHORITY" },
        "decisionSha256": { "const": "sha256:0667406e1ccc23439e2fb48d0bb2faee1abe4f5d5e0ad9c4e82fabd3b73c415a" },
        "approvalEventSha256": { "const": "sha256:2762f5819ed206d24abf435f4218cba4d05cfe8d458236598606a4d480c44eab" },
        "selection": { "const": "OPTION_A_AS_WRITTEN" },
        "representedAuthorities": { "const": ["Product/Architecture"] },
        "approvalRecordedAt": { "const": "2026-07-16T10:20:06Z" },
        "conditions": { "const": [] },
        "amendments": { "const": [] }
      }
    },
    "canonical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "priorSource", "package", "artifact", "releaseManifest", "digestSidecar", "protocol"],
      "properties": {
        "source": { "$ref": "#/$defs/repositoryPin" },
        "priorSource": { "$ref": "#/$defs/repositoryPin" },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "generatorName", "generatorVersion", "policySchemaVersion"],
          "properties": {
            "name": { "const": "@ceragon/shared-contracts" },
            "version": { "const": "0.3.0" },
            "generatorName": { "const": "ceragon-ai-security-artifact" },
            "generatorVersion": { "const": "1.0.0" },
            "policySchemaVersion": { "const": 1 }
          }
        },
        "artifact": { "$ref": "#/$defs/fileDescriptor" },
        "releaseManifest": { "$ref": "#/$defs/fileDescriptor" },
        "digestSidecar": { "$ref": "#/$defs/fileDescriptor" },
        "protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimumReadable", "maximumReadable", "readableVersions", "writableVersions", "nMinusOneShape", "runtimeActivatable", "signedRuntimePolicyBundle", "v2WriterEnabled"],
          "properties": {
            "minimumReadable": { "const": "1" },
            "maximumReadable": { "const": "2" },
            "readableVersions": { "const": ["1", "2"] },
            "writableVersions": { "const": ["1"] },
            "nMinusOneShape": { "const": "V1_LEGACY_ORG" },
            "runtimeActivatable": { "const": false },
            "signedRuntimePolicyBundle": { "const": false },
            "v2WriterEnabled": { "const": false }
          }
        }
      }
    },
    "consumers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "installer", "browser", "frontend"],
      "properties": {
        "backend": { "$ref": "#/$defs/consumerPin" },
        "installer": { "$ref": "#/$defs/consumerPin" },
        "browser": { "$ref": "#/$defs/consumerPin" },
        "frontend": { "$ref": "#/$defs/consumerPin" }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceCommit", "sourceTree", "canonicalArtifactAbsentAtTarget", "consumerStrategy", "runtimeActivationChanged"],
      "properties": {
        "sourceCommit": { "$ref": "#/$defs/commit" },
        "sourceTree": { "$ref": "#/$defs/commit" },
        "canonicalArtifactAbsentAtTarget": { "const": true },
        "consumerStrategy": { "const": "VENDORED_IMMUTABLE_STANDALONE" },
        "runtimeActivationChanged": { "const": false }
      }
    },
    "databaseMigrationIds": { "const": [] },
    "unsupportedSurfaces": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
    "activeWaivers": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 128 } }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "repositoryPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tree"],
      "properties": {
        "repository": { "type": "string", "minLength": 1, "maxLength": 64 },
        "commit": { "$ref": "#/$defs/commit" },
        "tree": { "$ref": "#/$defs/commit" }
      }
    },
    "fileDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$", "maxLength": 256 },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "consumerPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tree", "profile", "pin"],
      "properties": {
        "repository": { "enum": ["Backend", "Installers", "Installers/browser-extension", "Frontend"] },
        "commit": { "$ref": "#/$defs/commit" },
        "tree": { "$ref": "#/$defs/commit" },
        "profile": { "enum": ["BACKEND_C03_V1", "INSTALLER_C04_V1", "BROWSER_C05_V1", "FRONTEND_C06_V1"] },
        "pin": { "$ref": "#/$defs/fileDescriptor" }
      }
    }
  }
}