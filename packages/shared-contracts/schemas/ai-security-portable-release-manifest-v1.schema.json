{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.ceragon.ai/ai-security/portable-release-manifest-v1.schema.json",
  "title": "Ceragon AI security inert portable release descriptor V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "artifactKind",
    "artifactPath",
    "artifactDigest",
    "artifactBytes",
    "sourcePackageName",
    "sourcePackageVersion",
    "generatorName",
    "generatorVersion",
    "runtimeActivatable",
    "signedRuntimePolicyBundle",
    "v2WriterEligible",
    "requiredIntegrationGate"
  ],
  "properties": {
    "format": { "const": "ceragon.ai-security.portable-release" },
    "formatVersion": { "const": 1 },
    "artifactKind": { "const": "PORTABLE_CONTRACT" },
    "artifactPath": { "const": "portable-contract.v1.jcs.json" },
    "artifactDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifactBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "sourcePackageName": { "const": "@ceragon/shared-contracts" },
    "sourcePackageVersion": { "const": "0.3.0" },
    "generatorName": { "const": "ceragon-ai-security-artifact" },
    "generatorVersion": { "const": "1.2.0" },
    "runtimeActivatable": { "const": false },
    "signedRuntimePolicyBundle": { "const": false },
    "v2WriterEligible": { "const": false },
    "requiredIntegrationGate": { "const": "P0-C07" }
  }
}
